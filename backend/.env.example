# Environment
ENV=development
PORT=8080
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/alumni_connect?sslmode=disable

# Authentication
JWT_SECRET=dev-secret-key-at-least-32-characters-long-1234567890

# LinkedIn OAuth (Phase 1 M1)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/v1/auth/linkedin/callback
